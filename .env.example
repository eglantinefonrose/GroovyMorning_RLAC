# --- Configuration DeepSeek ---
# Votre clé d'API DeepSeek pour le découpage intelligent
DEEPSEEK_API_KEY=votre_cle_api_ici

# --- Configuration Segmenter ---
# Mode de détection : 'deepseek' ou 'legacy'
DETECTION_MODE=deepseek
# Utiliser Kyutai pour le STT (plus rapide, nécessite plus de RAM/GPU)
USE_KYUTAI=true
# Fournisseur de transcription (kyutai_stt, kyutai_mlx, kyutai, whisper)
TRANSCRIPTION_PROVIDER=kyutai_stt
# Mode simulation (pour tester avec des fichiers existants dans assets/recordings)
SIMU=true
# Fichier audio à utiliser pour la simulation (doit être dans 4.rd/@assets/3.modelEvaluationData/france-inter/audio/)
SIMU_AUDIO_FILE=07-07-2026.m4a
# Date cible pour la simulation (format YYYY-MM-DD, ex: 2026-05-27)
# Si non défini, utilise la date du jour (aujourd'hui)
# TARGET_DATE=2026-07-07

